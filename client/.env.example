# Leave empty to play offline. Example:
# EXPO_PUBLIC_GAME_API_URL=https://asia-southeast1-YOUR_PROJECT.cloudfunctions.net/gameApi

# Production App IDs go into the native config plugin; development defaults use Google's sample IDs.
# ADMOB_ANDROID_APP_ID=ca-app-pub-xxxxxxxxxxxxxxxx~xxxxxxxxxx
# ADMOB_IOS_APP_ID=ca-app-pub-xxxxxxxxxxxxxxxx~xxxxxxxxxx

# Production rewarded unit; development uses TestIds.REWARDED.
# EXPO_PUBLIC_ADMOB_REWARDED_UNIT_ID=ca-app-pub-xxxxxxxxxxxxxxxx/xxxxxxxxxx
