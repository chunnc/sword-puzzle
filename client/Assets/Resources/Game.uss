/* 1080-unit portrait reference. Art-backed elements use the panel fill in their PNG. */
.screen {
    flex-grow: 1; width: 100%; height: 100%;
    padding-left: 24px; padding-right: 24px;
    color: rgb(255, 244, 214);
    -unity-background-scale-mode: scale-and-crop;
}
.hud {
    height: 112px; flex-shrink: 0; flex-direction: row;
    align-items: center; justify-content: space-between;
    padding-left: 14px; padding-right: 14px;
    background-color: rgba(0, 0, 0, 0);
    -unity-background-scale-mode: stretch-to-fill;
}
.avatar { width: 94px; height: 94px; position: relative; flex-shrink: 0; }
.avatar-portrait, .avatar-frame {
    position: absolute; left: 0; right: 0; top: 0; bottom: 0;
    width: 100%; height: 100%;
}
.stat, .menu-button, .nav-item, .stage-node, .skill-button,
.wide-button, .map-continue, .realm-action {
    border-left-width: 0; border-right-width: 0;
    border-top-width: 0; border-bottom-width: 0;
    -unity-background-scale-mode: stretch-to-fill;
}
.stat {
    width: 183px; height: 70px; flex-shrink: 0;
    flex-direction: row; align-items: center; justify-content: center;
    padding-left: 22px; padding-right: 22px;
    background-color: rgba(0, 0, 0, 0); color: rgb(255, 247, 222);
    font-size: 28px; -unity-font-style: bold;
}
.stat-icon { width: 43px; height: 43px; margin-right: 8px; }
.stat-value {
    color: rgb(255, 247, 222); font-size: 26px;
    -unity-font-style: bold; -unity-text-align: middle-center;
}
.menu-button {
    width: 78px; height: 72px; flex-shrink: 0;
    align-items: center; justify-content: center;
    background-color: rgba(0, 0, 0, 0);
}
.menu-icon { width: 42px; height: 42px; }
.title-banner {
    height: 105px; flex-shrink: 0;
    margin-left: 80px; margin-right: 80px;
    align-items: center; justify-content: center;
    background-color: rgba(0, 0, 0, 0);
}
.title {
    font-size: 47px; -unity-font-style: bold;
    -unity-text-align: middle-center; color: rgb(255, 238, 190);
    letter-spacing: 2px;
}
.nav {
    height: 132px; flex-shrink: 0;
    flex-direction: row; align-items: center; justify-content: space-evenly;
    padding-left: 42px; padding-right: 42px;
    background-color: rgba(0, 0, 0, 0);
    -unity-background-scale-mode: stretch-to-fill;
}
.nav-item {
    width: 190px; height: 112px; flex-direction: column;
    align-items: center; justify-content: center;
    background-color: rgba(0, 0, 0, 0);
    padding: 0; margin: 0;
}
.nav-icon { width: 59px; height: 59px; opacity: .8; }
.nav-active .nav-icon { opacity: 1; }
.nav-label {
    font-size: 20px; color: rgb(241, 239, 215);
    -unity-text-align: middle-center;
}
.nav-active .nav-label { color: rgb(255, 226, 152); -unity-font-style: bold; }

.map-area { flex-grow: 1; min-height: 0; position: relative; }
.chapter-card {
    position: absolute; right: 4px; top: 18px;
    width: 224px; height: 296px;
    align-items: center; justify-content: center;
    padding: 35px 23px 25px 23px;
    background-color: rgba(0, 0, 0, 0);
    -unity-background-scale-mode: stretch-to-fill;
}
.chapter-small {
    font-size: 16px; color: rgb(105, 75, 38);
    -unity-text-align: middle-center; white-space: normal;
}
.chapter-title {
    font-size: 27px; -unity-font-style: bold;
    color: rgb(54, 39, 26);
    -unity-text-align: middle-center; white-space: normal;
}
.stage-node {
    position: absolute; width: 146px; height: 146px;
    align-items: center; justify-content: center;
    color: rgb(255, 246, 205); font-size: 52px;
    -unity-font-style: bold;
    background-color: rgba(0, 0, 0, 0);
}
.stage-1 { left: 43%; bottom: 9%; }
.stage-2 { left: 28%; bottom: 39%; }
.stage-3 { left: 48%; bottom: 67%; }
.stage-stars {
    position: absolute; bottom: -14px;
    color: rgb(255, 228, 137); font-size: 20px;
}
.map-continue {
    height: 108px; width: 430px; flex-shrink: 0;
    align-self: center; margin-bottom: 10px;
    color: rgb(62, 37, 16); font-size: 30px;
    -unity-font-style: bold; background-color: rgba(0, 0, 0, 0);
}

.game-stats {
    height: 112px; flex-shrink: 0; flex-direction: row;
    justify-content: space-between; margin-top: 8px;
}
.stat-card, .objective-card, .moves-card {
    height: 106px; align-items: center; justify-content: center;
    background-color: rgba(0, 0, 0, 0);
    -unity-background-scale-mode: stretch-to-fill;
}
.stat-card, .moves-card { width: 190px; }
.objective-card { width: 430px; }
.stat-caption {
    color: rgb(255, 224, 150); font-size: 20px;
    -unity-text-align: middle-center;
}
.stat-number { color: rgb(255, 249, 224); font-size: 38px; -unity-font-style: bold; }
.objective-row { flex-direction: row; align-items: center; justify-content: center; }
.objective-icon { width: 42px; height: 42px; margin-right: 5px; }
.objective-number { color: rgb(255, 249, 224); font-size: 35px; -unity-font-style: bold; }
.moves-number { color: rgb(255, 248, 213); font-size: 43px; -unity-font-style: bold; }
.game-main { flex-grow: 1; min-height: 0; align-items: center; }
.enemy-art { height: 186px; width: 370px; margin-top: 0; margin-bottom: -8px; }
.boss-art { height: 224px; width: 450px; margin-top: 0; margin-bottom: -10px; }
.board-space {
    flex-grow: 1; width: 100%; min-height: 0;
    align-items: center; justify-content: center;
}
.board-frame {
    padding: 10px; background-color: rgb(8, 46, 49);
    border-left-width: 5px; border-right-width: 5px;
    border-top-width: 5px; border-bottom-width: 5px;
    border-left-color: rgb(220, 182, 107); border-right-color: rgb(220, 182, 107);
    border-top-color: rgb(220, 182, 107); border-bottom-color: rgb(220, 182, 107);
    border-top-left-radius: 16px; border-top-right-radius: 16px;
    border-bottom-left-radius: 16px; border-bottom-right-radius: 16px;
}
.board-grid { flex-grow: 1; }
.board-row { flex-grow: 1; flex-direction: row; }
.board-cell { flex-grow: 1; position: relative; -unity-background-scale-mode: stretch-to-fill; }
.tile-overlay {
    position: absolute; left: 0; right: 0; top: 0; bottom: 0;
    -unity-background-scale-mode: stretch-to-fill;
}
.skill-area {
    height: 148px; flex-shrink: 0; flex-direction: row;
    align-items: center; margin-top: 4px;
    padding-left: 32px; padding-right: 42px;
    background-color: rgba(0, 0, 0, 0);
    -unity-background-scale-mode: stretch-to-fill;
}
.skill-button {
    width: 115px; height: 115px; flex-shrink: 0;
    align-items: center; justify-content: center;
    background-color: rgba(0, 0, 0, 0);
}
.skill-icon { width: 70px; height: 70px; }
.gauge-column {
    flex-grow: 1; height: 100%; align-items: center; justify-content: center;
    padding-left: 20px; padding-right: 15px;
}
.gauge-caption { font-size: 23px; color: rgb(255, 229, 159); -unity-font-style: bold; }
.bar-track {
    overflow: hidden; background-color: rgb(7, 39, 42);
    border-left-width: 3px; border-right-width: 3px;
    border-top-width: 3px; border-bottom-width: 3px;
    border-left-color: rgb(212, 177, 103); border-right-color: rgb(212, 177, 103);
    border-top-color: rgb(212, 177, 103); border-bottom-color: rgb(212, 177, 103);
    border-top-left-radius: 16px; border-top-right-radius: 16px;
    border-bottom-left-radius: 16px; border-bottom-right-radius: 16px;
}
.bar-fill { height: 100%; }
.fill-blue { background-color: rgb(73, 200, 229); }
.fill-red { background-color: rgb(229, 86, 70); }
.qi-bar { width: 100%; height: 33px; margin-top: 5px; }
.health-bar { width: 710px; height: 30px; margin-bottom: 10px; }
.gauge-value {
    font-size: 21px; color: rgb(255, 246, 221);
    -unity-text-align: middle-center;
}
.notice {
    font-size: 21px; color: rgb(255, 238, 171);
    -unity-text-align: middle-center;
}

.dialog-overlay {
    position: absolute; left: 0; right: 0; top: 0; bottom: 0;
    align-items: center; justify-content: center;
    background-color: rgba(0, 22, 27, .7);
}
.dialog-card {
    width: 680px; min-height: 780px;
    align-items: center; justify-content: center;
    padding: 95px 70px 80px 70px;
    background-color: rgba(0, 0, 0, 0);
    -unity-background-scale-mode: stretch-to-fill;
}
.subtitle {
    color: rgb(255, 230, 162); font-size: 35px;
    -unity-font-style: bold; -unity-text-align: middle-center;
    white-space: normal;
}
.body {
    color: rgb(244, 246, 225); font-size: 27px;
    -unity-text-align: middle-center; white-space: normal;
}
.small {
    color: rgb(237, 242, 220); font-size: 21px;
    -unity-text-align: middle-center; white-space: normal;
}
.center-area {
    flex-grow: 1; min-height: 0;
    align-items: center; justify-content: center;
}
.center-card {
    width: 760px; min-height: 800px;
    align-items: center; justify-content: center;
    padding: 100px 80px 85px 80px;
    background-color: rgba(0, 0, 0, 0);
    -unity-background-scale-mode: stretch-to-fill;
}
.account-card { min-height: 990px; }
.star-result {
    font-size: 100px; color: rgb(255, 219, 113);
    -unity-text-align: middle-center;
}
.wide-button {
    width: 100%; height: 92px; margin-top: 14px;
    font-size: 28px; -unity-font-style: bold;
    color: rgb(55, 38, 22); background-color: rgba(0, 0, 0, 0);
}
.realm-labels {
    height: 132px; flex-shrink: 0;
    flex-direction: row; align-items: center;
    justify-content: space-around; margin-top: 10px;
}
.realm-step {
    width: 295px; height: 106px;
    align-items: center; justify-content: center;
    background-color: rgba(0, 0, 0, 0);
    -unity-background-scale-mode: stretch-to-fill;
}
.realm-name { font-size: 32px; color: rgb(255, 235, 171); -unity-font-style: bold; }
.realm-arrow { color: rgb(255, 237, 171); font-size: 62px; }
.hero-space {
    flex-grow: 1; min-height: 0;
    align-items: center; justify-content: center;
}
.hero-art { height: 100%; width: 100%; }
.realm-bottom {
    height: 280px; flex-shrink: 0;
    align-items: center; justify-content: center;
    padding: 26px 90px;
    background-color: rgba(0, 0, 0, 0);
    -unity-background-scale-mode: stretch-to-fill;
}
.realm-bottom .qi-bar { width: 72%; }
.realm-bottom .small { margin-top: 3px; margin-bottom: 2px; font-size: 18px; }
.realm-action {
    width: 430px; height: 96px; margin-top: 4px;
    color: rgb(59, 39, 14); font-size: 36px;
    -unity-font-style: bold; background-color: rgba(0, 0, 0, 0);
}
.input {
    width: 100%; min-height: 83px; margin-top: 13px;
    padding: 12px; font-size: 25px;
    color: rgb(255, 244, 214); background-color: rgb(7, 41, 45);
    border-left-width: 2px; border-right-width: 2px;
    border-top-width: 2px; border-bottom-width: 2px;
    border-left-color: rgb(207, 169, 99); border-right-color: rgb(207, 169, 99);
    border-top-color: rgb(207, 169, 99); border-bottom-color: rgb(207, 169, 99);
}
.input .unity-text-field__input {
    background-color: rgb(7, 41, 45);
    color: rgb(255, 248, 224);
}
.toast {
    position: absolute; left: 25%; right: 25%; bottom: 165px;
    height: 88px; align-items: center; justify-content: center;
    background-color: rgba(0, 0, 0, 0);
}

/* The slice scale keeps both decorated ends smaller than the displayed height. */
.art-hud-chip {
    -unity-slice-left: 180; -unity-slice-right: 180;
    -unity-slice-top: 55; -unity-slice-bottom: 55;
    -unity-slice-scale: 0.28px;
}
.wide-button.art-button-secondary {
    color: rgb(249, 243, 218); background-color: rgba(0, 0, 0, 0);
}
