{
  "name": "kiem-khai-tien-lo-api",
  "version": "0.1.0",
  "private": true,
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "node ../tools/generate_game_content.mjs && tsc -p tsconfig.json",
    "test": "npm run build && node --test test/*.test.cjs",
    "test:integration": "npm run build && node --test --test-concurrency=1 test/integration/*.cjs",
    "serve": "npm run build && cd .. && firebase emulators:start --only functions,firestore,auth"
  },
  "dependencies": {
    "express": "^5.1.0",
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
